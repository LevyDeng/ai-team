# Generate the secret with: powershell -NoProfile -ExecutionPolicy Bypass -File .\New-Secret.ps1
WINDOWS_MCP_SECRET=
LOCAL_MCP_PORT=8000
REMOTE_MCP_PORT=18000
SSH_TARGET=relay@your-server.example
SSH_PORT=22
# Relay Desk reads this private key directly. Encrypted keys require an app passphrase prompt.
SSH_KEY_PATH=

# Shared upper limit for active desktop Claude and Codex conversations.
MAX_DESKTOP_SESSIONS=3
